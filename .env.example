# Telegram Bot (required for signal delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Kill switch: set false to suppress all Telegram sends (incident control).
# Failed sends retry with backoff, then land in data_store/telegram_dead_letter.json.
# TELEGRAM_ENABLED=true

# Admin dashboard (optional but recommended for public deploys)
# If set, the dashboard requires ?token=... on every page except /healthz
# ADMIN_TOKEN=pick-a-long-random-string

# Scheduler loop interval in seconds (default 900 = 15m)
# SCAN_INTERVAL_SECONDS=900

# Invo auto-share (REAL-money positions -- leave OFF until reviewed)
# INVO_ENABLED=false
# INVO_DRY_RUN=true
# INVO_EMAIL=

# Invo PAPER share (no real money). Autonomous login: the bot triggers an
# OTP to INVO_EMAIL and reads the code itself via Gmail IMAP, so it can
# re-login forever without you. Needs a Gmail App Password (revocable).
# INVO_PAPER_ENABLED=false
# INVO_PAPER_DRY_RUN=true
# INVO_EMAIL=
# INVO_GMAIL_APP_PASSWORD=
# INVO_PORTFOLIO_ID=
# INVO_SIM_SIZE=10.0
# Stable per-installation device id (generate once with: python -c "import uuid; print(uuid.uuid4())")
# INVO_DEVICE_ID=

# Live universe gate: only coins with validated history emit live alerts.
# Unvalidated (DATA_MISSING) coins are excluded unless explicitly opted in.
# LIVE_REQUIRE_VALIDATED=true
# LIVE_REQUIRE_VALIDATED=false   # restore full 14-coin live universe

# Exit Orchestrators (paper-only trade supervision; no real-money path exists)
# EXITS_ENABLED=true          # run supervision each scan cycle (monitor-only unless APPLY)
# EXITS_APPLY=false           # false = record decisions/proposals only; true = store plan overlays in exit ledger
#                             # AND propagate applied TP1/SL decisions + supervisor closes to Invo paper positions
#                             # (TP2/TP3 are never sent: the investments API carries one priceTarget)
# EXITS_MAX_EVALS_PER_CYCLE=20
# EXITS_MAX_DATA_AGE_S=1800   # completed-candle freshness limit
# EXITS_MIN_REEVAL_S=300      # fastest repeat evaluation per signal
# EXITS_MAX_REEVAL_S=3600     # scheduled reevaluation even with no event
# EXITS_STORAGE_DIR=data_store

# Binance API Keys (OPTIONAL - only needed for private endpoints)
# V1 uses only public endpoints, so these are not required
# BINANCE_API_KEY=
# BINANCE_API_SECRET=