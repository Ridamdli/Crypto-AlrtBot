# Telegram Bot (required for signal delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin dashboard (optional but recommended for public deploys)
# If set, the dashboard requires ?token=... on every page except /healthz
# ADMIN_TOKEN=pick-a-long-random-string

# Scheduler loop interval in seconds (default 900 = 15m)
# SCAN_INTERVAL_SECONDS=900

# Binance API Keys (OPTIONAL - only needed for private endpoints)
# V1 uses only public endpoints, so these are not required
# BINANCE_API_KEY=
# BINANCE_API_SECRET=